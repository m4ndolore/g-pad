[Unit]
Description=Anthink g-pad takeover (boot persistent)
# Offline kill switch: `touch /home/root/g-pad-boot-off` and the unit
# never runs; remove the file to re-enable.
ConditionPathExists=!/home/root/g-pad-boot-off
# Let xochitl's start job finish first so our stop cancels a settled
# unit instead of racing its startup for the panel.
After=xochitl.service

[Service]
Type=simple
ExecStart=/bin/bash /home/root/xovi/exthome/appload/g-pad/g-pad-boot.sh
# Any exit — crash, five-finger leave, power button — lands on the stock
# UI and stays there until the next boot. Never a restart loop.
Restart=no
# Whatever killed the pad, put the stock UI back.
ExecStopPost=/bin/systemctl start xochitl

[Install]
WantedBy=multi-user.target
